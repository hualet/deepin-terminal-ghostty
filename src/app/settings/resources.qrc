<RCC>
    <qresource prefix="/settings">
        <file>default-config.json</file>
    </qresource>
    <qresource prefix="/other">
        <file alias="ssh_login.sh">../remote/ssh_login.sh</file>
    </qresource>
    <qresource prefix="/icons/process">
        <file alias="codex.svg">../icons/process/codex.svg</file>
        <file alias="claude.svg">../icons/process/claude.svg</file>
        <file alias="gemini.svg">../icons/process/gemini.svg</file>
        <file alias="aider.svg">../icons/process/aider.svg</file>
        <file alias="opencode.svg">../icons/process/opencode.svg</file>
        <file alias="goose.svg">../icons/process/goose.svg</file>
        <file alias="github-copilot.svg">../icons/process/github-copilot.svg</file>
        <file alias="qwen.svg">../icons/process/qwen.svg</file>
        <file alias="shell.svg">../icons/process/shell.svg</file>
        <file alias="docker.svg">../icons/process/docker.svg</file>
        <file alias="podman.svg">../icons/process/podman.svg</file>
        <file alias="kubernetes.svg">../icons/process/kubernetes.svg</file>
        <file alias="helm.svg">../icons/process/helm.svg</file>
        <file alias="vim.svg">../icons/process/vim.svg</file>
        <file alias="nvim.svg">../icons/process/nvim.svg</file>
        <file alias="nano.svg">../icons/process/nano.svg</file>
        <file alias="emacs.svg">../icons/process/emacs.svg</file>
        <file alias="htop.svg">../icons/process/htop.svg</file>
        <file alias="terminal.svg">../icons/process/terminal.svg</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="dark.json">../themes/dark.json</file>
        <file alias="light.json">../themes/light.json</file>
        <file alias="bim.json">../themes/bim.json</file>
        <file alias="tomorrow-night-blue.json">../themes/tomorrow-night-blue.json</file>
        <file alias="ocean-dark.json">../themes/ocean-dark.json</file>
        <file alias="hybrid.json">../themes/hybrid.json</file>
        <file alias="one-light.json">../themes/one-light.json</file>
    </qresource>
</RCC>
