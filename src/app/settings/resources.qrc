<RCC>
    <qresource prefix="/settings">
        <file>default-config.json</file>
    </qresource>
    <qresource prefix="/other">
        <file alias="ssh_login.sh">../remote/ssh_login.sh</file>
    </qresource>
    <qresource prefix="/icons/app">
        <file alias="deepin-terminal-ghostty.png">../../../resources/logo_256x256.png</file>
    </qresource>
    <qresource prefix="/badges/process">
        <file alias="claude.webp">../../../resources/badges/process/claude.webp</file>
        <file alias="gemini.webp">../../../resources/badges/process/gemini.webp</file>
        <file alias="codex.webp">../../../resources/badges/process/codex.webp</file>
        <file alias="qwen.webp">../../../resources/badges/process/qwen.webp</file>
        <file alias="opencode.webp">../../../resources/badges/process/opencode.webp</file>
        <file alias="goose.webp">../../../resources/badges/process/goose.webp</file>
        <file alias="copilot.webp">../../../resources/badges/process/copilot.webp</file>
        <file alias="kimi.webp">../../../resources/badges/process/kimi.webp</file>
        <file alias="aider.svg">../../../resources/badges/process/aider.svg</file>
        <file alias="github-copilot.svg">../../../resources/badges/process/github-copilot.svg</file>
        <file alias="shell.svg">../../../resources/badges/process/shell.svg</file>
        <file alias="docker.svg">../../../resources/badges/process/docker.svg</file>
        <file alias="podman.svg">../../../resources/badges/process/podman.svg</file>
        <file alias="kubernetes.svg">../../../resources/badges/process/kubernetes.svg</file>
        <file alias="helm.svg">../../../resources/badges/process/helm.svg</file>
        <file alias="vim.svg">../../../resources/badges/process/vim.svg</file>
        <file alias="nvim.svg">../../../resources/badges/process/nvim.svg</file>
        <file alias="nano.svg">../../../resources/badges/process/nano.svg</file>
        <file alias="emacs.svg">../../../resources/badges/process/emacs.svg</file>
        <file alias="htop.svg">../../../resources/badges/process/htop.svg</file>
        <file alias="terminal.svg">../../../resources/badges/process/terminal.svg</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="dark.json">../themes/dark.json</file>
        <file alias="light.json">../themes/light.json</file>
        <file alias="classic-dark.json">../themes/classic-dark.json</file>
        <file alias="bim.json">../themes/bim.json</file>
        <file alias="tomorrow-night-blue.json">../themes/tomorrow-night-blue.json</file>
        <file alias="ocean-dark.json">../themes/ocean-dark.json</file>
        <file alias="hybrid.json">../themes/hybrid.json</file>
        <file alias="one-light.json">../themes/one-light.json</file>
    </qresource>
</RCC>
